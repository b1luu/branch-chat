# Copy to .env and fill in. Never commit .env.
# mock | ollama | anthropic
LLM_PROVIDER=mock
LLM_MAX_TOKENS=1024
# Context budget (estimated tokens) and the cap for the ancestor summary that replaces old turns
CONTEXT_TOKEN_BUDGET=60000
CONTEXT_SUMMARY_MAX_TOKENS=500
# Per-IP token bucket on reply/merge (429 + Retry-After). Trust X-Forwarded-For only behind our own proxy.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_BURST=10
RATE_LIMIT_TRUST_PROXY=false

# Ollama (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
# docker compose: the api container reaches the host's Ollama here (overrides OLLAMA_BASE_URL)
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Mark the shared ancestor prefix cacheable (cache_control breakpoints)
ANTHROPIC_PROMPT_CACHE=true

# docker compose sets its own DATABASE_URL (the db service); this one is for running the API on the host
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/branch_chat
